{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:factory:bs2-video-result:v1",
  "title": "BS2 Video Result",
  "type": "object",
  "required": ["streamId", "totalBytes", "chunkCount", "classification", "completedAt"],
  "properties": {
    "streamId": { "type": "string", "minLength": 1 },
    "totalBytes": { "type": "integer", "minimum": 0 },
    "chunkCount": { "type": "integer", "minimum": 1 },
    "classification": {
      "type": "string",
      "enum": ["business-activity-detected", "no-relevant-activity"]
    },
    "completedAt": { "type": "string" }
  },
  "additionalProperties": false
}
